---
import "../styles/global.css";
const { title = "AJ Ranzato" } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>

    <style></style>
  </head>

  <body>
    <header>
      <nav>
        <a href={base} class={currentPath === `${base}` ? "active" : ""}>
          Home
        </a>

        <a
          href={`${base}resume/`}
          class={currentPath === `${base}resume/` ? "active" : ""}
        >
          Resume
        </a>

        <a
          href={`${base}projects/`}
          class={currentPath === `${base}projects/` ? "active" : ""}
        >
          Selected Work
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>
