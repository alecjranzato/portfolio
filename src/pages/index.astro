---
import Layout from "../layouts/Layout.astro";
---

<Layout title="AJ Ranzato">
  <section class="home">
    <h1>Alec Jacob "A.J." Ranzato</h1>

    <p class="subtitle">
      Architectural History • Historic Preservation • Urban Planning
    </p>

    <p class="home-education">
      Princeton 2016 • NYU 2026 • Hunter College (Expected 2028)
    </p>

    <p>
      Architectural historian, heritage researcher, and emerging urban planner
      with graduate training in GIS-based spatial analysis, townscape
      morphology, and conservation policy. Combines practical experience at
      planning and conservation organizations with a decade of professional
      experience in strategy, project management, cross-functional
      collaboration, and digital marketing. Seeking planning and heritage roles
      where evidence-based analysis, community engagement, and practical policy
      solutions support context-sensitive urban development that balances
      cultural value with contemporary economic and sustainability needs.
    </p>

    <div class="home-links">
      <a href={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/resume/`}>
        View Resume
      </a>
      <a href={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/projects/`}>
        Selected Work
      </a>
    </div>
    <p class="home-contact">
      <a href="mailto:ajranzato9@gmail.com">ajranzato9@gmail.com</a>

      <span>•</span>

      <a
        href="https://www.linkedin.com/in/alecjacobranzato/"
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>

      <span>•</span>

      Brooklyn, NY
    </p>
  </section>
</Layout>
